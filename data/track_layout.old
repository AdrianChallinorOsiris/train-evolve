along_fwd = [
  { kind = "sensor", id = 6 },
  { kind = "sensor", id = 7 },
  { kind = "sensor", id = 8 },
  { kind = "point", id = 5 },
  { kind = "coupler", id = 1 },
]
reverses_direction = false
fwd_end = { kind = "interconnect", peer_track = 4, peer_side = "bwd" }
bwd_end = { kind = "interconnect", peer_track = 4, peer_side = "fwd" }

[[tracks]]
id = 4
along_fwd = [
  { kind = "coupler", id = 1 },
  { kind = "coupler", id = 2 },
  { kind = "coupler", id = 3 },
  { kind = "sensor", id = 9 }
]
reverses_direction = false
fwd_end = { kind = "interconnect", peer_track = 3, peer_side = "bwd" }
bwd_end = { kind = "interconnect", peer_track = 3, peer_side = "fwd" }

