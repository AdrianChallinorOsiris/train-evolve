# Canonical static layout for the model railway (edit to match your hardware).
# See docs/TRACK_LAYOUT.md for field meanings and invariants.

version = 1

[[tracks]]
id = 1
along_fwd = [
  { kind = "sensor", id = 1 },
  { kind = "sensor", id = 2 },
  { kind = "sensor", id = 3 },
]
reverses_direction = false
fwd_end = { kind = "interconnect", peer_track = 2, peer_side = "bwd" }
bwd_end = { kind = "interconnect", peer_track = 2, peer_side = "fwd" }

[[tracks]]
id = 2

along_fwd = [
  { kind = "sensor", id = 4 },
  { kind = "coupler", id = 1 },
  { kind = "coupler", id = 3 },
  { kind = "sensor", id = 5 },
]
reverses_direction = false
fwd_end = { kind = "interconnect", peer_track = 1, peer_side = "bwd" }
bwd_end = { kind = "interconnect", peer_track = 1, peer_side = "fwd" }

[[tracks]]
