[[tracks]]
id = 8
along_fwd = [
    { kind = "point", id = 9 },
    { kind = "sensor", id = 13 } ,
    { kind = "sensor", id = 14 }
]
reverses_direction = false
fwd_end = { kind = "interconnect", peer_track = 6, peer_side = "bwd" }
bwd_end = { kind = "interconnect", peer_track = 7, peer_side = "fwd" }

[[tracks]]
id = 9
along_fwd = [
    { kind = "sensor", id = 24 }
]
reverses_direction = true
fwd_end = { kind = "buffer" }
bwd_end = { kind = "buffer" }

[[tracks]]
id = 10
along_fwd = [
    { kind = "sensor", id = 17 }
]
reverses_direction = false
fwd_end = { kind = "buffer" }
bwd_end = { kind = "buffer" }

[[tracks]]
id = 11
along_fwd = [
    { kind = "point", id = 10}
]
reverses_direction = false
fwd_end = { kind = "buffer" }
bwd_end = { kind = "buffer" }

[[tracks]]
id = 12
along_fwd = [
    { kind = "sensor", id = 23 }
]
reverses_direction = false
fwd_end = { kind = "buffer" }
bwd_end = { kind = "buffer" }

[[couplers]]
id = 1
entry_a = { type = "track_port", track = 1, side = "bwd" }
thru_a = { type = "track_port", track = 1, side = "bwd" }
entry_b = { type = "track_port", track = 3, side = "fwd" }
thru_b = { type = "track_port", track = 4, side = "bwd" }

[[couplers]]
id = 2
entry_a = { type = "track_port", track = 4, side = "bwd" }
thru_a = { type = "track_port", track = 4, side = "bwd" }
entry_b = { type = "track_port", track = 6, side = "fwd" }
