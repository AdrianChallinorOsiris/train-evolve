entry_b = { type = "track_port", track = 6, side = "fwd" }
thru_b = { type = "track_port", track = 6, side = "fwd" }

[[points]]
id = 5
entry = { type = "track_port", track = 3, side = "fwd" }
thru = { type = "coupler_leg", coupler = 1, side = "b", leg = "entry" }
branch = { type = "point_leg", point = 13, leg = "entry" }

[[points]]
