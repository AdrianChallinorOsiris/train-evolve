#!/usr/bin/env bash
# Run the full test suite; on success bump Cargo.toml patch version, then git add -A, commit, push.
# Usage: ./scripts/commit "Your commit message"
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [ "$#" -ne 1 ]; then
  echo "Usage: $0 MESSAGE" >&2
  exit 1
fi

MESSAGE="$1"
CARGO_TOML="${ROOT}/Cargo.toml"

if [ ! -f "$CARGO_TOML" ]; then
  echo "error: Cargo.toml not found at ${CARGO_TOML}" >&2
  exit 1
fi

echo "Running cargo test (full suite)..."
if ! cargo test; then
  echo "error: tests failed. Fix failures before committing." >&2
  echo "error: no version bump and no git commands were run." >&2
  exit 1
fi

# First line that looks like [package] version (starts the line, after optional indent).
current=$(
  awk '
    /^[[:space:]]*version[[:space:]]*=/ {
      match($0, /"[^"]*"/)
      if (RSTART > 0) print substr($0, RSTART + 1, RLENGTH - 2)
      exit
    }
  ' "$CARGO_TOML"
)
current=$(echo "$current" | tr -d '[:space:]')

if [ -z "$current" ]; then
  echo "error: could not read [package] version from Cargo.toml" >&2
  exit 1
fi

new_version=$(echo "$current" | awk -F. '{$NF = $NF + 1; OFS = "."; print}')

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

# Replace only the first [package] version line; tolerate arbitrary spaces around '=' and quotes.
awk -v nv="$new_version" '
  /^[[:space:]]*version[[:space:]]*=/ && !done {
    print "version = \"" nv "\""
    done = 1
    next
  }
  { print }
' "$CARGO_TOML" >"$tmp"
mv "$tmp" "$CARGO_TOML"
trap - EXIT

echo "Bump version: ${current} -> ${new_version}"

git add -A
git commit -m "$MESSAGE"
git push
